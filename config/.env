# ============================================================
#  Weather App — Deployment Config (v3 fix)
#  All env vars declared — no drift.
# ============================================================

OPENWEATHER_API_KEY=demo_api_key_replace_me
PORT=5000

# Redis caching (added in v1)
REDIS_URL=redis://redis-service:6379
LOG_LEVEL=INFO

# Database & auth (added in v2)
DATABASE_URL=postgresql://db-service:5432/weatherapp
DB_USER=weatherapp_user
DB_PASSWORD=change_me_in_production
JWT_SECRET=change_me_in_production
RATE_LIMIT_PER_HOUR=100

# Alerts & notifications (added in v3)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=alerts@weatherapp.example.com
SMTP_PASSWORD=change_me_in_production
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/change_me
SENTRY_DSN=https://change_me@sentry.io/0
ALERT_THRESHOLD_CELSIUS=35
WEATHER_UNITS=metric
FORECAST_DAYS=7
